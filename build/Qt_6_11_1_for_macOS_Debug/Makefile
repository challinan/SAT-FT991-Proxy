FT991A-emulator.app/Contents/PkgInfo: 
	@test -d FT991A-emulator.app/Contents || mkdir -p FT991A-emulator.app/Contents
	@$(DEL_FILE) FT991A-emulator.app/Contents/PkgInfo
	@echo "APPL????" > FT991A-emulator.app/Contents/PkgInfo
FT991A-emulator.app/Contents/Info.plist: 
	@test -d FT991A-emulator.app/Contents || mkdir -p FT991A-emulator.app/Contents
	@$(DEL_FILE) FT991A-emulator.app/Contents/Info.plist
	@set -o pipefail && plutil -convert xml1 -o - ../../../../Qt-6.11/6.11.1/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,Home.FT991A-emulator,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},Home.FT991A-emulator,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,FT991A-emulator,g" -e "s,@LIBRARY@,FT991A-emulator,g" -e "s,\$${EXECUTABLE_NAME},FT991A-emulator,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >FT991A-emulator.app/Contents/Info.plist

