install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/FT991A-emulator/bin || mkdir -p $(INSTALL_ROOT)/opt/FT991A-emulator/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/FT991A-emulator/bin/FT991A-emulator.app
	
	$(QINSTALL) FT991A-emulator.app $(INSTALL_ROOT)/opt/FT991A-emulator/bin/FT991A-emulator.app

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/FT991A-emulator/bin/FT991A-emulator.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/FT991A-emulator/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

